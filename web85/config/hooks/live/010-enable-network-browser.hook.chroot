#!/bin/sh
set -eu
chmod 0755 /usr/local/sbin/puppy50-network-probe
chmod 0755 /etc/skel/.config/openbox/autostart
systemctl enable NetworkManager.service
systemctl enable lightdm.service
systemctl enable puppy50-network-probe.service
# Do not install to any physical disk. The live image uses toram for optional
# full read-only-system copying, plus RAM overlay for session changes.
mkdir -p /usr/share/puppy50web
echo 'PUPPY50_V85_LIVE_IMAGE_CONFIGURATION=COMPLETE'
